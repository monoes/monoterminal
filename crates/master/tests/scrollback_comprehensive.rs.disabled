// Comprehensive scrollback/ring buffer tests
// Tests overflow handling, line numbering, and edge cases
// SRS §2.1.3: 10k lines in-memory scrollback

use monoterminal_master::session::scrollback::RingBuffer;
use monoterminal_master::session::session::Line;

#[test]
fn test_empty_buffer() {
    let buf: RingBuffer<Line> = RingBuffer::new(100);
    assert_eq!(buf.len(), 0);
    assert!(buf.is_empty());
    assert!(!buf.is_full());
}

#[test]
fn test_push_single_line() {
    let mut buf = RingBuffer::new(100);
    buf.push_line(b"first line".to_vec());

    assert_eq!(buf.len(), 1);
    assert!(!buf.is_empty());
    assert!(!buf.is_full());
}

#[test]
fn test_push_multiple_lines() {
    let mut buf = RingBuffer::new(100);

    for i in 0..50 {
        buf.push_line(format!("line {}", i).into_bytes());
    }

    assert_eq!(buf.len(), 50);
    assert!(!buf.is_full());
}

#[test]
fn test_buffer_fills_to_capacity() {
    let mut buf = RingBuffer::new(10);

    for i in 0..10 {
        buf.push_line(format!("line {}", i).into_bytes());
    }

    assert_eq!(buf.len(), 10);
    assert!(buf.is_full());
}

#[test]
fn test_buffer_overflow_overwrites_oldest() {
    let mut buf = RingBuffer::new(3);

    buf.push_line(b"line 0".to_vec());
    buf.push_line(b"line 1".to_vec());
    buf.push_line(b"line 2".to_vec());
    assert_eq!(buf.len(), 3);
    assert!(buf.is_full());

    // This should overwrite line 0
    buf.push_line(b"line 3".to_vec());

    assert_eq!(buf.len(), 3);
    assert!(buf.is_full());

    // Verify contents (should have lines 1, 2, 3)
    let lines: Vec<_> = buf.iter().collect();
    assert_eq!(lines[0].data, b"line 1");
    assert_eq!(lines[1].data, b"line 2");
    assert_eq!(lines[2].data, b"line 3");
}

#[test]
fn test_line_numbers_sequential() {
    let mut buf = RingBuffer::new(5);

    for i in 0..5 {
        buf.push_line(format!("line {}", i).into_bytes());
    }

    let lines: Vec<_> = buf.iter().collect();
    for (i, line) in lines.iter().enumerate() {
        assert_eq!(line.line_number, i as u64);
    }
}

#[test]
fn test_line_numbers_after_overflow() {
    let mut buf = RingBuffer::new(3);

    for i in 0..5 {
        buf.push_line(format!("line {}", i).into_bytes());
    }

    let lines: Vec<_> = buf.iter().collect();

    // Should have lines 2, 3, 4 with line numbers 2, 3, 4
    assert_eq!(lines[0].line_number, 2);
    assert_eq!(lines[1].line_number, 3);
    assert_eq!(lines[2].line_number, 4);
}

#[test]
fn test_clear_empties_buffer() {
    let mut buf = RingBuffer::new(10);

    for i in 0..10 {
        buf.push_line(format!("line {}", i).into_bytes());
    }

    assert!(buf.is_full());

    buf.clear();

    assert_eq!(buf.len(), 0);
    assert!(buf.is_empty());
    assert!(!buf.is_full());
}

#[test]
fn test_clear_and_reuse() {
    let mut buf = RingBuffer::new(5);

    buf.push_line(b"line 1".to_vec());
    buf.push_line(b"line 2".to_vec());

    buf.clear();

    buf.push_line(b"line 3".to_vec());
    buf.push_line(b"line 4".to_vec());

    assert_eq!(buf.len(), 2);

    let lines: Vec<_> = buf.iter().collect();
    assert_eq!(lines[0].data, b"line 3");
    assert_eq!(lines[1].data, b"line 4");
}

#[test]
fn test_iter_order() {
    let mut buf = RingBuffer::new(5);

    buf.push_line(b"A".to_vec());
    buf.push_line(b"B".to_vec());
    buf.push_line(b"C".to_vec());

    let lines: Vec<_> = buf.iter().map(|l| l.data[0] as char).collect();
    assert_eq!(lines, vec!['A', 'B', 'C']);
}

#[test]
fn test_iter_after_wraparound() {
    let mut buf = RingBuffer::new(3);

    buf.push_line(b"A".to_vec());
    buf.push_line(b"B".to_vec());
    buf.push_line(b"C".to_vec());
    buf.push_line(b"D".to_vec()); // Overwrites A
    buf.push_line(b"E".to_vec()); // Overwrites B

    let lines: Vec<_> = buf.iter().map(|l| l.data[0] as char).collect();
    assert_eq!(lines, vec!['C', 'D', 'E']);
}

#[test]
fn test_empty_line() {
    let mut buf = RingBuffer::new(5);
    buf.push_line(Vec::new());

    assert_eq!(buf.len(), 1);
    let lines: Vec<_> = buf.iter().collect();
    assert_eq!(lines[0].data.len(), 0);
}

#[test]
fn test_large_line() {
    let mut buf = RingBuffer::new(5);
    let large_data = vec![b'X'; 100_000]; // 100KB line

    buf.push_line(large_data.clone());

    assert_eq!(buf.len(), 1);
    let lines: Vec<_> = buf.iter().collect();
    assert_eq!(lines[0].data.len(), 100_000);
    assert_eq!(lines[0].data, large_data);
}

#[test]
fn test_binary_data() {
    let mut buf = RingBuffer::new(5);
    let binary_data: Vec<u8> = (0..=255).collect();

    buf.push_line(binary_data.clone());

    let lines: Vec<_> = buf.iter().collect();
    assert_eq!(lines[0].data, binary_data);
}

#[test]
fn test_utf8_data() {
    let mut buf = RingBuffer::new(5);
    let utf8_text = "Hello 世界 🚀".as_bytes().to_vec();

    buf.push_line(utf8_text.clone());

    let lines: Vec<_> = buf.iter().collect();
    assert_eq!(lines[0].data, utf8_text);
    assert_eq!(String::from_utf8_lossy(&lines[0].data), "Hello 世界 🚀");
}

#[test]
fn test_ansi_escape_sequences() {
    let mut buf = RingBuffer::new(5);
    let ansi_line = b"\x1b[31mRed Text\x1b[0m".to_vec();

    buf.push_line(ansi_line.clone());

    let lines: Vec<_> = buf.iter().collect();
    assert_eq!(lines[0].data, ansi_line);
}

#[test]
fn test_capacity_boundary() {
    let mut buf = RingBuffer::new(1);

    buf.push_line(b"first".to_vec());
    assert_eq!(buf.len(), 1);
    assert!(buf.is_full());

    buf.push_line(b"second".to_vec());
    assert_eq!(buf.len(), 1);
    assert!(buf.is_full());

    let lines: Vec<_> = buf.iter().collect();
    assert_eq!(lines[0].data, b"second");
}

#[test]
fn test_large_capacity() {
    let mut buf = RingBuffer::new(10_000); // SRS spec

    for i in 0..5000 {
        buf.push_line(format!("line {}", i).into_bytes());
    }

    assert_eq!(buf.len(), 5000);
    assert!(!buf.is_full());

    for i in 5000..10_000 {
        buf.push_line(format!("line {}", i).into_bytes());
    }

    assert_eq!(buf.len(), 10_000);
    assert!(buf.is_full());
}

#[test]
fn test_stress_many_overwrites() {
    let mut buf = RingBuffer::new(100);

    // Write 1000 lines to a 100-capacity buffer
    for i in 0..1000 {
        buf.push_line(format!("line {}", i).into_bytes());
    }

    assert_eq!(buf.len(), 100);
    assert!(buf.is_full());

    // Should have lines 900-999
    let lines: Vec<_> = buf.iter().collect();
    assert_eq!(lines.first().unwrap().line_number, 900);
    assert_eq!(lines.last().unwrap().line_number, 999);
}

// ===== Property Tests =====

#[cfg(test)]
mod proptest_tests {
    use super::*;
    use proptest::prelude::*;

    proptest! {
        #[test]
        fn prop_len_never_exceeds_capacity(
            capacity in 1usize..1000,
            push_count in 0usize..2000
        ) {
            let mut buf: RingBuffer<Line> = RingBuffer::new(capacity);

            for i in 0..push_count {
                buf.push_line(format!("line {}", i).into_bytes());
            }

            prop_assert!(buf.len() <= capacity);

            if push_count >= capacity {
                prop_assert_eq!(buf.len(), capacity);
                prop_assert!(buf.is_full());
            } else {
                prop_assert_eq!(buf.len(), push_count);
                prop_assert!(!buf.is_full());
            }
        }

        #[test]
        fn prop_line_numbers_monotonic(
            capacity in 10usize..100,
            push_count in 10usize..200
        ) {
            let mut buf: RingBuffer<Line> = RingBuffer::new(capacity);

            for i in 0..push_count {
                buf.push_line(format!("line {}", i).into_bytes());
            }

            let lines: Vec<_> = buf.iter().collect();

            // Line numbers should be strictly increasing
            for i in 1..lines.len() {
                prop_assert!(lines[i].line_number > lines[i-1].line_number);
                prop_assert_eq!(lines[i].line_number, lines[i-1].line_number + 1);
            }
        }

        #[test]
        fn prop_data_integrity(data in prop::collection::vec(any::<u8>(), 0..1000)) {
            let mut buf: RingBuffer<Line> = RingBuffer::new(10);

            buf.push_line(data.clone());

            let lines: Vec<_> = buf.iter().collect();
            prop_assert_eq!(&lines[0].data, &data);
        }

        #[test]
        fn prop_clear_idempotent(capacity in 1usize..100) {
            let mut buf: RingBuffer<Line> = RingBuffer::new(capacity);

            buf.push_line(b"test".to_vec());
            buf.clear();
            buf.clear(); // Clear twice

            prop_assert_eq!(buf.len(), 0);
            prop_assert!(buf.is_empty());
        }

        #[test]
        fn prop_iter_count_matches_len(
            capacity in 1usize..100,
            push_count in 0usize..200
        ) {
            let mut buf: RingBuffer<Line> = RingBuffer::new(capacity);

            for i in 0..push_count {
                buf.push_line(format!("line {}", i).into_bytes());
            }

            let iter_count = buf.iter().count();
            prop_assert_eq!(iter_count, buf.len());
        }
    }
}
