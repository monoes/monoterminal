// Session state machine property tests
// Tests state transitions and invariants
// SRS §2.1.3: Session lifecycle

use tokio::sync::mpsc;
use tokio_util::task::AbortOnDrop;
use uuid::Uuid;
use std::time::Duration;

// Mock PTY Backend for testing
struct MockPtyBackend {
    pid: u32,
}

impl MockPtyBackend {
    fn new() -> Self {
        Self { pid: 12345 }
    }
}

// Simplified trait implementation for testing
#[async_trait::async_trait]
impl monoterminal_master::pty::PtyBackend for MockPtyBackend {
    async fn create(_config: monoterminal_master::pty::PtyConfig) -> monoterminal_master::pty::PtyResult<Self>
    where
        Self: Sized,
    {
        Ok(Self::new())
    }

    async fn read(&mut self, _buf: &mut [u8]) -> std::io::Result<usize> {
        Ok(0)
    }

    async fn write(&mut self, data: &[u8]) -> std::io::Result<()> {
        Ok(())
    }

    fn resize(&mut self, _rows: u16, _cols: u16) -> monoterminal_master::pty::PtyResult<()> {
        Ok(())
    }

    fn shell_pid(&self) -> u32 {
        self.pid
    }

    async fn terminate(self: Box<Self>) -> monoterminal_master::pty::PtyResult<()> {
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use monoterminal_master::session::session::*;
    use std::path::PathBuf;

    /// Helper to create dummy AbortOnDrop handles for tests
    fn create_dummy_abort_handles() -> (AbortOnDrop, AbortOnDrop) {
        // Create dummy tasks that do nothing
        let handle1 = tokio::spawn(async {
            tokio::time::sleep(Duration::from_secs(3600)).await;
        });
        let handle2 = tokio::spawn(async {
            tokio::time::sleep(Duration::from_secs(3600)).await;
        });

        (
            AbortOnDrop::new(handle1.abort_handle()),
            AbortOnDrop::new(handle2.abort_handle()),
        )
    }

    #[tokio::test]
    async fn test_session_creation() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let session = Session::new(
            session_id,
            12345, // shell_pid from MockPtyBackend
            "pwsh.exe".to_string(),
            PathBuf::from("C:\\"),
            24,
            80,
        );

        assert_eq!(session.id, session_id);
        assert_eq!(session.state, SessionState::Running);
        assert_eq!(session.dimensions.rows, 24);
        assert_eq!(session.dimensions.cols, 80);
        assert_eq!(session.shell_type, "pwsh.exe");
        assert_eq!(session.clients.len(), 0);
        assert_eq!(session.monomind_detected, false);
    }

    #[tokio::test]
    async fn test_session_starts_in_running_state() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let session = Session::new(
            session_id,
            12345, // shell_pid from MockPtyBackend
            "cmd.exe".to_string(),
            PathBuf::from("C:\\"),
            24,
            80,        );

        assert_eq!(session.state, SessionState::Running);
    }

    #[tokio::test]
    async fn test_client_attach() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let mut session = Session::new(
            session_id,
            12345, // shell_pid from MockPtyBackend
            "cmd.exe".to_string(),
            PathBuf::from("C:\\"),
            24,
            80,        );

        let client_id = Uuid::new_v4();
        let (tx, _rx) = mpsc::channel(32);
        session.attach_client(client_id, tx);

        assert_eq!(session.clients.len(), 1);
        assert!(session.clients.iter().any(|(id, _)| id == &client_id));
    }

    #[tokio::test]
    async fn test_client_attach_idempotent() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let mut session = Session::new(
            session_id,
            12345, // shell_pid from MockPtyBackend
            "cmd.exe".to_string(),
            PathBuf::from("C:\\"),
            24,
            80,        );

        let client_id = Uuid::new_v4();
        let (tx1, _rx1) = mpsc::channel(32);
        let (tx2, _rx2) = mpsc::channel(32);
        session.attach_client(client_id, tx1);
        session.attach_client(client_id, tx2); // Attach same client twice

        // Should only have one copy
        assert_eq!(session.clients.len(), 1);
    }

    #[tokio::test]
    async fn test_multiple_clients_attach() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let mut session = Session::new(
            session_id,
            12345, // shell_pid from MockPtyBackend
            "cmd.exe".to_string(),
            PathBuf::from("C:\\"),
            24,
            80,        );

        let client1 = Uuid::new_v4();
        let client2 = Uuid::new_v4();
        let client3 = Uuid::new_v4();

        let (tx1, _rx1) = mpsc::channel(32);
        let (tx2, _rx2) = mpsc::channel(32);
        let (tx3, _rx3) = mpsc::channel(32);
        session.attach_client(client1, tx1);
        session.attach_client(client2, tx2);
        session.attach_client(client3, tx3);

        assert_eq!(session.clients.len(), 3);
        assert!(session.clients.iter().any(|(id, _)| id == &client1));
        assert!(session.clients.iter().any(|(id, _)| id == &client2));
        assert!(session.clients.iter().any(|(id, _)| id == &client3));
    }

    #[tokio::test]
    async fn test_client_detach() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let mut session = Session::new(
            session_id,
            12345, // shell_pid from MockPtyBackend
            "cmd.exe".to_string(),
            PathBuf::from("C:\\"),
            24,
            80,        );

        let client_id = Uuid::new_v4();
        let (tx, _rx) = mpsc::channel(32);
        session.attach_client(client_id, tx);
        assert_eq!(session.clients.len(), 1);

        session.detach_client(client_id);
        assert_eq!(session.clients.len(), 0);
    }

    #[tokio::test]
    async fn test_detach_nonexistent_client() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let mut session = Session::new(
            session_id,
            12345, // shell_pid from MockPtyBackend
            "cmd.exe".to_string(),
            PathBuf::from("C:\\"),
            24,
            80,        );

        let client_id = Uuid::new_v4();
        // Detach without attaching first
        session.detach_client(client_id);

        // Should be no-op
        assert_eq!(session.clients.len(), 0);
    }

    #[tokio::test]
    async fn test_partial_client_detach() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let mut session = Session::new(
            session_id,
            12345, // shell_pid from MockPtyBackend
            "cmd.exe".to_string(),
            PathBuf::from("C:\\"),
            24,
            80,        );

        let client1 = Uuid::new_v4();
        let client2 = Uuid::new_v4();
        let client3 = Uuid::new_v4();

        let (tx1, _rx1) = mpsc::channel(32);
        let (tx2, _rx2) = mpsc::channel(32);
        let (tx3, _rx3) = mpsc::channel(32);
        session.attach_client(client1, tx1);
        session.attach_client(client2, tx2);
        session.attach_client(client3, tx3);

        // Detach middle client
        session.detach_client(client2);

        assert_eq!(session.clients.len(), 2);
        assert!(session.clients.iter().any(|(id, _)| id == &client1));
        assert!(!session.clients.iter().any(|(id, _)| id == &client2));
        assert!(session.clients.iter().any(|(id, _)| id == &client3));
    }

    #[tokio::test]
    async fn test_snapshot_creation() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let session = Session::new(
            session_id,
            pty,
            "pwsh.exe".to_string(),
            PathBuf::from("C:\\Users\\test"),
            30,
            100,        );

        let snapshot = session.snapshot();

        assert_eq!(snapshot.id, session_id);
        assert_eq!(snapshot.rows, 30);
        assert_eq!(snapshot.cols, 100);
        assert_eq!(snapshot.shell_type, "pwsh.exe");
        assert_eq!(snapshot.working_dir, PathBuf::from("C:\\Users\\test"));
        assert_eq!(snapshot.scrollback.len(), 0); // No lines yet
    }

    #[tokio::test]
    async fn test_touch_updates_activity() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let mut session = Session::new(
            session_id,
            12345, // shell_pid from MockPtyBackend
            "cmd.exe".to_string(),
            PathBuf::from("C:\\"),
            24,
            80,        );

        let initial_time = session.last_activity;
        tokio::time::sleep(Duration::from_millis(10)).await;

        session.touch();

        assert!(session.last_activity > initial_time);
    }

    #[tokio::test]
    async fn test_dimensions_stored_correctly() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let session = Session::new(
            session_id,
            pty,
            "cmd.exe".to_string(),
            PathBuf::from("C:\\"),
            50,
            120,        );

        assert_eq!(session.dimensions.rows, 50);
        assert_eq!(session.dimensions.cols, 120);
    }

    #[tokio::test]
    async fn test_shell_pid_available() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let session = Session::new(
            session_id,
            12345, // shell_pid from MockPtyBackend
            "cmd.exe".to_string(),
            PathBuf::from("C:\\"),
            24,
            80,        );

        assert_eq!(session.shell_pid, 12345); // Mock PID
    }

    #[tokio::test]
    async fn test_scrollback_capacity() {
        let session_id = Uuid::new_v4();
        let pty = Box::new(MockPtyBackend::new());
        let session = Session::new(
            session_id,
            12345, // shell_pid from MockPtyBackend
            "cmd.exe".to_string(),
            PathBuf::from("C:\\"),
            24,
            80,        );

        // Scrollback should be empty initially but have capacity
        assert_eq!(session.scrollback.len(), 0);
        assert!(!session.scrollback.is_full());
    }

    #[test]
    fn test_state_equality() {
        assert_eq!(SessionState::Running, SessionState::Running);
        assert_eq!(SessionState::Terminated, SessionState::Terminated);
        assert_ne!(SessionState::Running, SessionState::Terminated);
    }
}

// ===== Property-Based Tests =====

#[cfg(test)]
mod proptest_tests {
    use super::*;
    use proptest::prelude::*;
    use monoterminal_master::session::session::*;
    use std::path::PathBuf;

    /// Helper to create dummy AbortOnDrop handles for tests
    fn create_dummy_abort_handles() -> (AbortOnDrop, AbortOnDrop) {
        // Create dummy tasks that do nothing
        let handle1 = tokio::spawn(async {
            tokio::time::sleep(Duration::from_secs(3600)).await;
        });
        let handle2 = tokio::spawn(async {
            tokio::time::sleep(Duration::from_secs(3600)).await;
        });

        (
            AbortOnDrop::new(handle1.abort_handle()),
            AbortOnDrop::new(handle2.abort_handle()),
        )
    }

    // Strategy for generating valid terminal dimensions
    fn dimensions_strategy() -> impl Strategy<Value = (u16, u16)> {
        (1u16..500, 1u16..500)
    }

    proptest! {
        #![proptest_config(ProptestConfig {
            cases: 20,  // Reduce test cases
            timeout: 3000,  // 3 second timeout per test
            ..ProptestConfig::default()
        })]

        #[test]
        fn prop_client_attach_detach_inverse(client_count in 1usize..10) {  // Reduce from 20 to 10
            let rt = tokio::runtime::Runtime::new().unwrap();
            rt.block_on(async {
                let session_id = Uuid::new_v4();
                let pty = Box::new(MockPtyBackend::new());
                let mut session = Session::new(
                    session_id,
                    pty,
                    "cmd.exe".to_string(),
                    PathBuf::from("C:\\"),
                    24,
                    80,                );

            // Attach N clients
            let client_ids: Vec<_> = (0..client_count).map(|_| Uuid::new_v4()).collect();
            for &id in &client_ids {
                let (tx, _rx) = mpsc::channel(32);
                session.attach_client(id, tx);
            }

            prop_assert_eq!(session.clients.len(), client_count);

            // Detach all clients
            for &id in &client_ids {
                session.detach_client(id);
            }

            prop_assert_eq!(session.clients.len(), 0);
                Ok(())
            })?;
        }

        #[test]
        fn prop_dimensions_preserved((rows, cols) in dimensions_strategy()) {
            let rt = tokio::runtime::Runtime::new().unwrap();
            rt.block_on(async {
                let session_id = Uuid::new_v4();
                let pty = Box::new(MockPtyBackend::new());
                let session = Session::new(
                    session_id,
                    pty,
                    "cmd.exe".to_string(),
                    PathBuf::from("C:\\"),
                    rows,
                    cols,                );

            prop_assert_eq!(session.dimensions.rows, rows);
            prop_assert_eq!(session.dimensions.cols, cols);

            // Snapshot should also preserve dimensions
            let snapshot = session.snapshot();
            prop_assert_eq!(snapshot.rows, rows);
            prop_assert_eq!(snapshot.cols, cols);
                Ok(())
            })?;
        }

        #[test]
        fn prop_attach_detach_order_independent(
            operations in prop::collection::vec((any::<bool>(), any::<u8>()), 1..50)
        ) {
            let rt = tokio::runtime::Runtime::new().unwrap();
            rt.block_on(async {
                let session_id = Uuid::new_v4();
                let pty = Box::new(MockPtyBackend::new());
                let mut session = Session::new(
                    session_id,
                    pty,
                    "cmd.exe".to_string(),
                    PathBuf::from("C:\\"),
                    24,
                    80,                );

            // Use fixed set of client IDs (indexed by u8 % 10)
            let client_pool: Vec<_> = (0..10).map(|_| Uuid::new_v4()).collect();

            for (attach, idx) in operations {
                let client_id = client_pool[idx as usize % 10];
                if attach {
                    let (tx, _rx) = mpsc::channel(32);
                    session.attach_client(client_id, tx);
                } else {
                    session.detach_client(client_id);
                }
            }

            // Invariant: clients list should never exceed pool size
            prop_assert!(session.clients.len() <= 10);
                Ok(())
            })?;
        }

        #[test]
        fn prop_touch_monotonic_time(touch_count in 1usize..20) {  // Reduce from 100 to 20
            let rt = tokio::runtime::Runtime::new().unwrap();
            rt.block_on(async {
                let session_id = Uuid::new_v4();
                let pty = Box::new(MockPtyBackend::new());
                let mut session = Session::new(
                    session_id,
                    pty,
                    "cmd.exe".to_string(),
                    PathBuf::from("C:\\"),
                    24,
                    80,                );

                let mut last_time = session.last_activity;

                for _ in 0..touch_count {
                    tokio::time::sleep(Duration::from_micros(10)).await; // Reduce sleep from 100μs to 10μs
                    session.touch();

                    // Time should be monotonically increasing or equal
                    prop_assert!(session.last_activity >= last_time);
                    last_time = session.last_activity;
                }
                Ok(())
            })?;
        }
    }
}
